# Reference sample binaries (decompiled research samples)
**/reference/
*.exe
*.apk

# Allow compiled standalone distribution binaries (< 1 MB)
!dist/*.exe
!dist/*.apk
!dist/*.zip
!website/downloads/*.exe
!website/downloads/*.zip
!website/downloads/*.apk

# Temporary files & caches
node_modules/
.vercel/
scratch/
.vscode/
.gemini/
.idea/

# Local database and server state
website/server/data/tts_cache/*.mp3
website/server/data/donations.json
website/server/data/users.json
website/server/secret_token.txt
*.log

# Environment variables & secrets
.env
.env.local
.env.*.local

# Android & .NET build artifacts
.gradle/
**/build/
**/bin/
**/obj/

<Window x:Class="TengeAlert.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TengeAlert Desktop Companion" Height="580" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#0a0d14" Foreground="#f8fafc" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="#1e2638">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#00f5a0" Margin="0,0,14,0">
                        <TextBlock Text="₸" FontSize="20" FontWeight="Bold" Foreground="#051510" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TengeAlert Desktop" FontSize="18" FontWeight="SemiBold" Foreground="#f8fafc"/>
                        <TextBlock Text="Перехват уведомлений из Связь с телефоном (Phone Link)" FontSize="12" Foreground="#8a99ad"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="#14201e" BorderBrush="#00f5a0" BorderThickness="1" CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#00f5a0" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" Text="Служба активна" FontSize="11" FontWeight="Medium" Foreground="#00f5a0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Controls / Config Card -->
        <Border Grid.Row="1" Background="#101522" BorderBrush="#1e2638" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Адрес шлюза TengeAlert" FontSize="12" Foreground="#8a99ad" Margin="0,0,0,6"/>
                    <TextBox x:Name="ServerUrlBox" Text="http://localhost:3000" Background="#070a0f" Foreground="#f8fafc" BorderBrush="#252f44" BorderThickness="1" Padding="10,8" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Токен стримера (Secret)" FontSize="12" Foreground="#8a99ad" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TokenBox" Password="ta_streamer_demo_token" Background="#070a0f" Foreground="#f8fafc" BorderBrush="#252f44" BorderThickness="1" Padding="10,8" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="ToggleServiceBtn" Content="Остановить" Click="ToggleService_Click" Background="#1a2335" Foreground="#f8fafc" BorderBrush="#2b3952" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="TestDonationBtn" Content="Тест 5 000 ₸" Click="TestDonation_Click" Background="#00f5a0" Foreground="#051510" FontWeight="SemiBold" BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Log Card -->
        <Border Grid.Row="2" Background="#101522" BorderBrush="#1e2638" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Журнал перехваченных событий в реальном времени" FontSize="12" FontWeight="SemiBold" Foreground="#8a99ad" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Очистить" Click="ClearLog_Click" Background="Transparent" Foreground="#8a99ad" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                </DockPanel>

                <TextBox Grid.Row="1" x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#070a0f" Foreground="#7dd3fc" BorderBrush="#1e2638" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Padding="10"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Задержка передачи в OBS: &lt; 5 мс | WinRT UserNotificationListener" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
            <TextBlock Text="TengeAlert v1.0.0" FontSize="11" Foreground="#475569" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="TengeAlert.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TengeAlert Desktop" Height="620" Width="880"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#090a0f" Foreground="#f8fafc" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    
    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#141824"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#222b3d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryGreenButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Foreground" Value="#04120c"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ControlDeckButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#121722"/>
            <Setter Property="BorderBrush" Value="#1d2536"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============================================== -->
        <!-- VIEW 1: ACTIVATION / LOGIN SCREEN             -->
        <!-- ============================================== -->
        <Grid x:Name="ActivationView" Visibility="Collapsed" Background="#090a0f">
            <Border Width="420" Background="#0f1420" BorderBrush="#1f283b" BorderThickness="1" CornerRadius="16" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#10b981" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="₸" FontSize="24" FontWeight="Bold" Foreground="#04120c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="TengeAlert — Вход" FontSize="20" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Введите секретный токен стримера из личного кабинета" FontSize="12" Foreground="#8a99ad" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                    <TextBlock Text="ТОКЕН СТРИМЕРА (SECRET)" FontSize="11" FontWeight="Bold" Foreground="#8a99ad" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="LoginTokenBox" Background="#070a0f" Foreground="#f8fafc" BorderBrush="#252f44" BorderThickness="1" Padding="12,10" FontSize="13" Margin="0,0,0,18"/>

                    <Button x:Name="LoginBtn" Content="Войти в аккаунт" Click="LoginBtn_Click" Style="{StaticResource PrimaryGreenButton}" Height="44" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Токен находится в кабинете на сайте: tengealert.kz/dashboard/" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- VIEW 2: MAIN STREAMER DESKTOP DECK            -->
        <!-- ============================================== -->
        <Grid x:Name="MainDeckView" Visibility="Visible" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Padding="0,0,0,16" BorderThickness="0,0,0,1" BorderBrush="#1a2233">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#10b981" Margin="0,0,12,0">
                            <TextBlock Text="₸" FontSize="19" FontWeight="Bold" Foreground="#04120c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TengeAlert Desktop" FontSize="16" FontWeight="Bold" Foreground="#f8fafc"/>
                            <TextBlock Text="Автономный шлюз перехвата Kaspi и Halyk" FontSize="11" Foreground="#8a99ad"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Status Pill -->
                        <Border Background="#101e19" BorderBrush="#10b981" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10b981" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="Служба активна" FontSize="11" FontWeight="SemiBold" Foreground="#10b981"/>
                            </StackPanel>
                        </Border>

                        <!-- Settings Button -->
                        <Button x:Name="OpenSettingsBtn" Content="Настройки" Click="OpenSettingsBtn_Click" Style="{StaticResource ActionButton}" Padding="12,6" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Work Area (2 Columns) -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: Stream Controls Deck -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!-- Big Run/Stop Button -->
                    <Button x:Name="StartStopBtn" Content="Остановить" Click="StartStopBtn_Click" Style="{StaticResource PrimaryGreenButton}" Height="46" Margin="0,0,0,14"/>

                    <!-- Phone Connection Section -->
                    <Border Background="#101420" BorderBrush="#1c2436" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ИСТОЧНИК ПУШЕЙ" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse x:Name="PhoneStatusDot" Width="7" Height="7" Fill="#10b981" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PhoneSourceText" Text="Связь с телефоном (ПК)" FontSize="11" Foreground="#f8fafc" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button x:Name="PairPhoneBtn" Content="Подключить телефон" Click="PairPhoneBtn_Click" Style="{StaticResource ActionButton}" Padding="8,6" FontSize="11" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Stream Control Buttons -->
                    <TextBlock Text="УПРАВЛЕНИЕ ЭФИРОМ" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                    
                    <Button x:Name="TestDonationBtn" Click="TestDonation_Click" Style="{StaticResource ControlDeckButton}">
                        <TextBlock Text="Тестовый донат (5 000 ₸)"/>
                    </Button>
                    
                    <Button x:Name="SkipTtsBtn" Click="SkipTtsBtn_Click" Style="{StaticResource ControlDeckButton}">
                        <TextBlock Text="Скип озвучки (Mute TTS)"/>
                    </Button>

                    <Button x:Name="SkipAlertBtn" Click="SkipAlertBtn_Click" Style="{StaticResource ControlDeckButton}">
                        <TextBlock Text="Скип алерта (Next)"/>
                    </Button>

                    <Button x:Name="ClearScreenBtn" Click="ClearScreenBtn_Click" Style="{StaticResource ControlDeckButton}">
                        <TextBlock Text="Очистить экран OBS"/>
                    </Button>
                </StackPanel>

                <!-- RIGHT MAIN: Top Stats & Live Donation Feed -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top 2 Widgets: Top Stream & Top Month -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top Stream -->
                        <Border Grid.Column="0" Background="#101420" BorderBrush="#1c2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ТОП СТРИМА" FontSize="10" FontWeight="Bold" Foreground="#e5a93c" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TopStreamText" Text="Ожидание донатов в эфире..." FontSize="12" Foreground="#8a99ad"/>
                            </StackPanel>
                        </Border>

                        <!-- Top Month -->
                        <Border Grid.Column="1" Background="#101420" BorderBrush="#1c2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ТОП МЕСЯЦА" FontSize="10" FontWeight="Bold" Foreground="#10b981" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TopMonthText" Text="Данные синхронизируются..." FontSize="12" Foreground="#8a99ad"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live Feed Container -->
                    <Border Grid.Row="1" Background="#101420" BorderBrush="#1c2436" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ЛЕНТА ДОНАТОВ В РЕАЛЬНОМ ВРЕМЕНИ" FontSize="11" FontWeight="Bold" Foreground="#8a99ad" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Очистить ленту" Click="ClearFeed_Click" Background="Transparent" Foreground="#64748b" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </DockPanel>

                            <!-- Empty State Placeholder -->
                            <StackPanel x:Name="EmptyFeedPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#141824" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="₸" FontSize="22" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Лента пустая, ожидание входящих донатов..." FontSize="13" Foreground="#64748b" HorizontalAlignment="Center"/>
                                <TextBlock Text="Сделайте тестовый перевод или нажмите «Тестовый донат»" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Active Donations List -->
                            <ScrollViewer Grid.Row="1" x:Name="FeedScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="FeedListPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Status Footer -->
            <Border Grid.Row="2" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="#1a2233">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Задержка передачи в OBS: &lt; 5 мс • WinRT &amp; Phone Link • P2P 0% комиссии" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock Text="tengealert.kz • v1.0.0" FontSize="11" Foreground="#475569" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- MODAL 1: PHONE PAIRING GUIDE (BLUETOOTH / APP) -->
        <!-- ============================================== -->
        <Grid x:Name="PhoneModal" Visibility="Collapsed" Background="#aa05070a">
            <Border Width="520" Background="#0f1420" BorderBrush="#1f283b" BorderThickness="1" CornerRadius="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Подключение смартфона (Kaspi / Halyk)" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,8"/>
                    <TextBlock Text="Выберите удобный способ перехвата уведомлений:" FontSize="12" Foreground="#8a99ad" Margin="0,0,0,16"/>

                    <Border Background="#141926" BorderBrush="#222c3d" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Способ 1: Windows «Связь с телефоном» (Рекомендуется для Android)" FontSize="13" FontWeight="Bold" Foreground="#10b981" Margin="0,0,0,6"/>
                            <TextBlock Text="1. Откройте приложение «Связь с телефоном» в Windows.&#x0a;2. Сопрягите ваш телефон.&#x0a;3. Включите доступ к уведомлениям Kaspi и Halyk.&#x0a;TengeAlert Desktop автоматически перехватит пуши через WinRT." FontSize="11" Foreground="#8a99ad" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#141926" BorderBrush="#222c3d" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Способ 2: Прямой Bluetooth (Для iPhone по Apple ANCS)" FontSize="13" FontWeight="Bold" Foreground="#e5a93c" Margin="0,0,0,6"/>
                            <TextBlock Text="1. Сопрягите iPhone с ПК: Параметры Windows → Bluetooth.&#x0a;2. На iPhone: Настройки → Bluetooth → этот ПК → включить «Показывать уведомления».&#x0a;3. Уведомления будут поступать на ПК даже с заблокированным экраном." FontSize="11" Foreground="#8a99ad" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Параметры Bluetooth Windows" Click="OpenBluetoothSettings_Click" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                        <Button Content="Готово" Click="ClosePhoneModal_Click" Style="{StaticResource PrimaryGreenButton}" Width="90"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- MODAL 2: SETTINGS (BANKS, HOTKEYS, LOGOUT)     -->
        <!-- ============================================== -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed" Background="#aa05070a">
            <Border Width="500" Background="#0f1420" BorderBrush="#1f283b" BorderThickness="1" CornerRadius="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Настройки TengeAlert" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,16"/>

                    <!-- Bank Parsers -->
                    <TextBlock Text="ПАРСЕРЫ БАНКОВ КАЗАХСТАНА" FontSize="11" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,16">
                        <CheckBox x:Name="CbKaspiGold" Content="Kaspi Gold" IsChecked="True" Foreground="#f8fafc" Margin="0,0,16,8"/>
                        <CheckBox x:Name="CbKaspiPay" Content="Kaspi Pay" IsChecked="True" Foreground="#f8fafc" Margin="0,0,16,8"/>
                        <CheckBox x:Name="CbHalyk" Content="Halyk Bank" IsChecked="True" Foreground="#f8fafc" Margin="0,0,16,8"/>
                        <CheckBox x:Name="CbFreedom" Content="Freedom Bank" IsChecked="True" Foreground="#f8fafc" Margin="0,0,16,8"/>
                    </WrapPanel>

                    <!-- Hotkeys info -->
                    <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ В ИГРЕ" FontSize="11" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                    <Border Background="#141926" BorderBrush="#222c3d" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Скип озвучки (Mute TTS):" FontSize="12" Foreground="#8a99ad"/>
                                <TextBlock Text="Ctrl + Shift + F10" FontSize="12" FontWeight="Bold" Foreground="#10b981" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Скип текущего алерта:" FontSize="12" Foreground="#8a99ad"/>
                                <TextBlock Text="Ctrl + Shift + F9" FontSize="12" FontWeight="Bold" Foreground="#e5a93c" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Выйти из аккаунта" Click="LogoutBtn_Click" Background="#261418" Foreground="#ef4444" BorderBrush="#3f1e24" BorderThickness="1" Padding="12,8" Cursor="Hand"/>
                        <Button DockPanel.Dock="Right" Content="Сохранить" Click="CloseSettingsModal_Click" Style="{StaticResource PrimaryGreenButton}" Width="100"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
